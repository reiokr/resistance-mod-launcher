{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resistance Mod Launcher",
  "version": "0.1.0",
  "identifier": "io.github.xcom2linux.modlauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resistance Mod Launcher",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
