{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resistance Mod Launcher",
  "version": "0.1.0",
  "identifier": "io.github.xcom2linux.modlauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resistance Mod Launcher",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Native mod launcher for XCOM 2: War of the Chosen",
    "longDescription": "Unofficial native Linux mod launcher and load-order manager for XCOM 2: War of the Chosen. Imports AML settings, edits XComModOptions.ini, manages categories and profiles, checks conflicts and dependencies, edits mod configs, and shows ReadMe files.",
    "copyright": "Copyright (C) 2026 the Resistance Mod Launcher contributors",
    "publisher": "Resistance Mod Launcher contributors",
    "homepage": "https://github.com/reiokr/resistance-mod-launcher",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../PROVENANCE.md": "PROVENANCE.md",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
